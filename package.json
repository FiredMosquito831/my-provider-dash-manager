{
  "name": "multi-acc-manager",
  "version": "0.2.2",
  "description": "Multi-account manager for Vercel/Netlify/Supabase-style dashboards",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "spike": "electron . --spike",
    "smoke": "electron . --smoke",
    "smoke:restore": "electron . --smoke-restore",
    "smoke:tokens": "electron . --smoke-tokens",
    "capture": "electron . --capture",
    "dist": "electron-builder --win",
    "smoke:creds": "electron . --smoke-creds",
    "smoke:autofill": "electron . --smoke-autofill",
    "internal:save": "git --git-dir=.internal-git --work-tree=. add -f CLAUDE.md PROJECT.md docs/WORKLOG.md docs/LEARNINGS.md docs/BACKLOG.md docs/DECISIONS.md docs/AUDIT-*.md && git --git-dir=.internal-git --work-tree=. commit -m \"internal artifacts snapshot\"",
    "internal:log": "git --git-dir=.internal-git --work-tree=. log --oneline"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "build": {
    "appId": "com.firedmosquito.my-provider-dash-manager",
    "productName": "My Provider Dash Manager",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "FiredMosquito831",
      "repo": "my-provider-dash-manager"
    },
    "artifactName": "My-Provider-Dash-Manager-Setup-${version}.${ext}"
  }
}