{
  "name": "my-provider-dash-manager",
  "version": "0.8.0",
  "description": "CLI to install and update My Provider Dash Manager: a free Windows desktop app that keeps many accounts per service (Vercel, Netlify, Supabase, Cloudflare, AWS, Google, Microsoft, GitHub, Gmail) signed in at once, each in a fully isolated session. Also available as mpdm.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "spike": "electron . --spike",
    "smoke": "electron . --smoke",
    "smoke:restore": "electron . --smoke-restore",
    "smoke:tokens": "electron . --smoke-tokens",
    "capture": "electron . --capture",
    "dist": "electron-builder --win",
    "smoke:creds": "electron . --smoke-creds",
    "smoke:autofill": "electron . --smoke-autofill",
    "internal:save": "git --git-dir=.internal-git --work-tree=. add -f CLAUDE.md docs/WORKING-NOTES.md && git --git-dir=.internal-git --work-tree=. commit -m \"internal notes snapshot\"",
    "internal:log": "git --git-dir=.internal-git --work-tree=. log --oneline",
    "smoke:updates": "electron . --smoke-updates",
    "smoke:services": "electron . --smoke-services",
    "smoke:dark": "electron . --smoke-dark",
    "install:latest": "node scripts/install-latest.js"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "build": {
    "appId": "com.firedmosquito.my-provider-dash-manager",
    "productName": "My Provider Dash Manager",
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "FiredMosquito831",
      "repo": "my-provider-dash-manager"
    },
    "artifactName": "My-Provider-Dash-Manager-Setup-${version}.${ext}"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "my-provider-dash-manager": "scripts/cli.js",
    "mpdm": "scripts/cli.js"
  },
  "files": [
    "scripts/cli.js",
    "scripts/install-latest.js",
    "docs/screenshots",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiredMosquito831/my-provider-dash-manager.git"
  },
  "homepage": "https://github.com/FiredMosquito831/my-provider-dash-manager",
  "bugs": {
    "url": "https://github.com/FiredMosquito831/my-provider-dash-manager/issues"
  },
  "author": "FiredMosquito831",
  "keywords": [
    "multi-account",
    "account-manager",
    "account-switcher",
    "session-isolation",
    "browser-profiles",
    "isolated-sessions",
    "desktop-app",
    "electron",
    "windows",
    "developer-tools",
    "dashboard",
    "ad-block",
    "adblocker",
    "dark-mode",
    "password-manager",
    "password-importer",
    "vercel",
    "netlify",
    "supabase",
    "cloudflare",
    "aws",
    "azure",
    "google",
    "microsoft",
    "google-cloud",
    "github",
    "gitlab",
    "npm",
    "stripe",
    "gmail",
    "proton-mail",
    "cli"
  ],
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}